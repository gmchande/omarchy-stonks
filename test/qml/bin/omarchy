#!/usr/bin/env bash
# A stand-in for the omarchy command, first on PATH inside the walks, so a
# footer click that restarts the shell restarts nothing: `plugin update`
# succeeds, as one with nothing new does, and anything else is refused the
# way `omarchy restart shell` is while the session is locked.
[ "$1 $2" = "plugin update" ] && exit 0
echo "Refusing to restart Omarchy shell while the session is locked." >&2
exit 1
