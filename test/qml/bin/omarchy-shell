#!/usr/bin/env bash
# A stand-in for omarchy-shell, first on PATH inside the harnesses, so a
# harness never asks the owner's shell anything. It appends its arguments as
# one line to STONKS_FAKE_STATE/omarchy-shell.calls, and answers
# `notifications dndState` with what STONKS_FAKE_STATE/dnd holds, "on" or
# "off". With no such file it fails as omarchy-shell does when the shell
# has no notifications target, as with another app showing notifications.
# Every other call answers nothing.
echo "$*" >> "$STONKS_FAKE_STATE/omarchy-shell.calls"
if [ "$1 $2" = "notifications dndState" ]; then
  if [ -e "$STONKS_FAKE_STATE/dnd" ]; then
    cat "$STONKS_FAKE_STATE/dnd"
  else
    echo "Target not found." >&2
    exit 1
  fi
fi
exit 0
