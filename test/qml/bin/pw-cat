#!/usr/bin/env bash
# A stand-in for pw-cat, first on PATH inside the harnesses, so no harness
# ever holds an output open: it records each stream of silence as lines in
# STONKS_FAKE_STATE/pw-cat.log, "start MS ARGS" and then "stopped MS" when
# Stonks stops it, and plays nothing meanwhile. It waits in short sleeps, so
# a kill that skips its trap leaves nothing behind for long.
log="$STONKS_FAKE_STATE/pw-cat.log"
ms() { echo $(( $(date +%s%N) / 1000000 )); }
trap 'echo "stopped $(ms)" >> "$log"; exit 0' TERM INT
echo "start $(ms) $*" >> "$log"
while :; do sleep 0.2; done
