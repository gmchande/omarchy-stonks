#!/usr/bin/env bash
# A stand-in for pw-cat, first on PATH inside the walks, so no walk ever
# holds an output open. It plays nothing: 100 ms on it prints the line
# pw-cat -v prints as its stream reaches a waking output, then waits, in
# short sleeps, until Stonks stops it.
trap 'exit 0' TERM INT
sleep 0.1
echo "stream state changed paused -> streaming" >&2
while :; do sleep 0.2; done
