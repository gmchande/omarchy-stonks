#!/usr/bin/env bash
# Stand-in ln, first on PATH in the harnesses: the real ln, but it waits
# while STONKS_FAKE_STATE/ln.hold exists and fails, as a disk refusing the
# link would, while STONKS_FAKE_STATE/ln.fail exists.
state=${STONKS_FAKE_STATE:-}
while [ -n "$state" ] && [ -e "$state/ln.hold" ]; do sleep 0.05; done
if [ -n "$state" ] && [ -e "$state/ln.fail" ]; then
  echo "ln: the harness refuses the link" >&2
  exit 1
fi
exec /usr/bin/ln "$@"
