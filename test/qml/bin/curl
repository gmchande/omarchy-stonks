#!/usr/bin/env bash
# A stand-in for curl, first on PATH inside the walks. It answers from
# saved answers (test/fixtures) by symbol, so the real feeds run without
# the network, and it logs what it is asked, which the walks count:
# <SYMBOL>.calls and <SYMBOL>.history.calls, SEARCH.asked.calls,
# FUNDAMENTALS.calls, RATE.calls, OVERNIGHT.calls and INSTRUMENTS.calls in
# STONKS_FAKE_STATE, each URL as "kind name status" in requests.log, and
# each call's URLs in runs.log.
#
# A day's quote:
#   AAPL, MSFT, NVDA   the saved AAPL day, up 2.61%, without its after-hours
#                trades, so the day's move is on top; with them while
#                STONKS_FAKE_STATE/after-hours exists
#   TALL<n>      like AAPL, its history too: a long list whose every range
#                answers
#   LONG<n>      NEST's saved day of 7 October at 14:55, under its own name:
#                a long list of busy US stocks
#   STRAY        the saved NEST day with one dropped bucket
#   SHOP.TO, SPY, BTC-USD   their saved days
# and, while STONKS_FAKE_STATE/overnight.set names one or more folders of
# test/fixtures/moments, any symbol with a file there answers from the
# first folder that has it: its day, a two-day ask (2d/<symbol>.json), and
# its 1M and 3M histories. Any other symbol fails. Every chart answer names
# the symbol asked for, whichever saved day it carries.
#
# A history: the saved AAPL year for AAPL, MSFT and TALL<n>, NEST's saved
# month, and their own saved years for KILN, SPY, ^GSPC, BTC-USD, SHEL.L and
# 7203.T. A spark request answers each of its symbols from that symbol's
# day, closes only, in Yahoo's spark shape; one that would fail is left out.
#
# A search answers the saved SHOP results after 0.4 s, whatever the words,
# and fails while STONKS_FAKE_STATE/SEARCH.down exists.
#
# Fundamentals answer from test/fixtures/fundamentals by symbol (MSFT and
# NVDA take AAPL's; a symbol with none saved gets SPY's, every series
# empty), a rate from fx-<pair>.json or 404 for a pair with none saved.
#
# Robinhood's historicals answer from the moment's robinhood-day.json, in
# the order asked, span=hour with each listing's last 12 slots, LONG<n> with
# NEST's under its own name, and every symbol empty with no moment set; more
# than 75 symbols in one request answer 400, as Robinhood does. While
# STONKS_FAKE_STATE/NIGHT.bar holds "BEGINS_AT PRICE", each listing's
# answer ends with a night bar there at that price, in place of any bar
# with that start, as Robinhood answers a bar still forming. Its
# instruments answer from the moment's robinhood-instruments.json, or say
# every symbol trades all day, 100 results a page.
#
# GitHub's manifest fails, and any other GitHub address answers 404.
#
# Like curl, it takes several URLs in one call and answers each in turn,
# each followed by the -w line Fetch.js asks for: the status (200, 400, 404,
# 429 while refused, 502 for a failure, 000 for no answer), curl's exit
# code, and the URL's place. An answer over --max-filesize is cut there
# with exit code 63. While STONKS_FAKE_STATE/<HOST>.refuse exists (YAHOO,
# ROBINHOOD, GITHUB), that host answers 429 to every request; while
# <HOST>.offline exists, it gives no answer at all.

set -u
fixtures="${STONKS_FIXTURES:?}"
state="${STONKS_FAKE_STATE:?}"
# in_moment FILE: FILE in the first folder overnight.set names that has it,
# else in the first one.
in_moment() {
  local name first=""
  for name in $(cat "$state/overnight.set" 2>/dev/null); do
    [ -n "$first" ] || first="$fixtures/moments/$name/$1"
    if [ -e "$fixtures/moments/$name/$1" ]; then
      echo "$fixtures/moments/$name/$1"
      return
    fi
  done
  echo "$first"
}
# count FILE: one more call, under a lock, since a quote and a history request
# for one symbol can run at once; prints the new count.
count() {
  exec 9>>"$1.lock"
  flock 9
  local calls=$(( $(cat "$1" 2>/dev/null || echo 0) + 1 ))
  echo "$calls" > "$1"
  flock -u 9
  echo "$calls"
}
# What one URL is: its kind and its name in the logs.
kind_of() {
  case "$1" in
    *"raw.githubusercontent.com/"*) echo manifest ;;
    *"/v1/finance/search"*) echo search ;;
    *"api.robinhood.com/instruments/"*) echo instruments ;;
    *"api.robinhood.com/"*) echo overnight ;;
    *"/v8/finance/chart/"*"%3DX?"*) echo rate ;;
    *"/fundamentals-timeseries/"*|*"interval=1d&period1="*) echo fundamentals ;;
    *"includeAdjustedClose=true"*) echo history ;;
    *"/v7/finance/spark"*) echo spark ;;
    *) echo chart ;;
  esac
}
name_of() {
  case "$2" in
    search|instruments|overnight|manifest) echo "$2" ;;
    spark) local s="${1#*symbols=}"; echo "${s%%&*}" ;;
    fundamentals) local s="${1##*/timeseries/}"; s="${s##*/chart/}"; echo "${s%%\?*}" ;;
    rate) local s="${1##*/chart/}"; echo "${s%%%3DX*}" ;;
    *) local s="${1##*/chart/}"; echo "${s%%\?*}" ;;
  esac
}

# serve URL: one URL's answer on stdout; its exit code says what kind:
# 0 an answer, 22 a failure (502), 40 a request refused as asked (400),
# 43 forbidden (403), 44 not found (404).
serve() {
  local url=$1
  if [[ "$url" == *"raw.githubusercontent.com/"* ]]; then
    [ "$url" = https://raw.githubusercontent.com/gmchande/omarchy-stonks/main/manifest.json ] || exit 44
    exit 22
  fi
  if [[ "$url" == *"/v7/finance/spark"* ]]; then
    local list="${url#*symbols=}" range="${url#*range=}" sym body served days=()
    list="${list%%&*}"
    range="${range%%&*}"
    for sym in ${list//,/ }; do
      body=$(serve "https://query1.finance.yahoo.com/v8/finance/chart/$sym?range=$range&interval=5m&includePrePost=true")
      served=$?
      [ "$served" = 0 ] && days+=("$body")
    done
    printf '%s\n' "${days[@]}" | jq -cs '{ spark: { result: map(.chart.result[0] | { symbol: .meta.symbol,
      response: [{ meta: .meta, timestamp: .timestamp, indicators: { quote: [{ close: .indicators.quote[0].close }] } }] }) } }'
    exit 0
  fi
  if [[ "$url" == *"/v1/finance/search"* ]]; then
    count "$state/SEARCH.asked.calls" > /dev/null
    sleep 0.4
    [ -e "$state/SEARCH.down" ] && exit 22
    cat "$fixtures/search.json"
    exit
  fi
  if [[ "$url" == *"api.robinhood.com/instruments/"* ]]; then
    count "${STONKS_FAKE_STATE:?}/INSTRUMENTS.calls" > /dev/null
    asked="${url#*symbols=}"
    saved_answer="$(in_moment robinhood-instruments.json)"
    if [ -f "$saved_answer" ]; then
      jq -c --arg asked "$asked" '($asked | split(",")) as $want | .results |= map(select(.symbol as $s | $want | index($s)))' "$saved_answer"
    else
      jq -nc --arg asked "$asked" '{ next: null, results: [($asked | split(","))[] | { symbol: ., all_day_tradability: "tradable" }] }'
    fi | jq -c 'if (.results | length) > 100 then .next = "https://api.robinhood.com/instruments/?cursor=page2" | .results |= .[:100] else . end'
    exit
  fi
  if [[ "$url" == *"api.robinhood.com/marketdata/historicals/"* ]]; then
    count "${STONKS_FAKE_STATE:?}/OVERNIGHT.calls" > /dev/null
    asked="${url#*symbols=}"
    asked="${asked%%&*}"
    span="${url#*span=}"
    span="${span%%&*}"
    if [ "$(tr ',' '\n' <<< "$asked" | wc -l)" -gt 75 ]; then
      echo '{"non_field_errors":["Too many instruments requested. No more than 75 allowed."]}'
      exit 40
    fi
    set_name="$(cat "$STONKS_FAKE_STATE/overnight.set" 2>/dev/null)"
    read -r bar_at bar_price < "$STONKS_FAKE_STATE/NIGHT.bar" 2> /dev/null || bar_at=""
    if [ -n "$set_name" ]; then
      jq -c --arg asked "$asked" --arg span "$span" --arg at "$bar_at" --arg price "${bar_price:-}" '($asked | split(",")) as $want
        | { results: [$want[] as $s | (($s | if test("^LONG[0-9]+$") then "NEST" else . end) as $from
          | [.results[] | select(.symbol == $from)][0] | if . then .symbol = $s | .span = $span
            | if $at != "" then .historicals |= ([.[] | select(.begins_at != $at)] + [{ begins_at: $at, open_price: $price,
                close_price: $price, high_price: $price, low_price: $price, volume: 100, session: "overnight", interpolated: false }]) else . end
            | if $span == "hour" then .historicals |= .[-12:] else . end
          else { symbol: "", historicals: [] } end)] }' \
        "$(in_moment robinhood-day.json)"
    else
      jq -nc --arg asked "$asked" '{ results: [($asked | split(","))[] | { symbol: "", historicals: [] }] }'
    fi
    exit
  fi
  if [[ "$url" == *"/v8/finance/chart/"*"%3DX?"* ]]; then
    pair="${url##*/chart/}"
    pair="${pair%%%3DX*}"
    count "$state/RATE.calls" > /dev/null
    count "$state/$pair.rate.calls" > /dev/null
    file="$fixtures/fundamentals/fx-$(tr 'A-Z' 'a-z' <<< "$pair").json"
    [ -e "$file" ] || exit 44
    cat "$file"
    exit
  fi
  # saved SYMBOL [SUFFIX]: the fundamentals fixture that answers for SYMBOL.
  saved() {
    local name
    case "$1" in AAPL|MSFT|NVDA) name=aapl ;; *) name=$(tr 'A-Z.' 'a-z-' <<< "$1") ;; esac
    local file="$fixtures/fundamentals/$name${2:-}.json"
    [ -e "$file" ] || file="$fixtures/fundamentals/spy${2:-}.json"
    echo "$file"
  }
  if [[ "$url" == *"/fundamentals-timeseries/"* || "$url" == *"interval=1d&period1="* ]]; then
    count "${STONKS_FAKE_STATE:?}/FUNDAMENTALS.calls" > /dev/null
    if [[ "$url" == *"/timeseries/"* ]]; then
      symbol="${url##*/timeseries/}"
      symbol="${symbol%%\?*}"
      count "$STONKS_FAKE_STATE/$symbol.fundamentals.calls" > /dev/null
      file="$(saved "$symbol")"
    else
      symbol="${url##*/chart/}"
      symbol="${symbol%%\?*}"
      file="$(saved "$symbol" -closes)"
    fi
    cat "$file"
    exit
  fi
  symbol="${url##*/chart/}"
  symbol="${symbol%%\?*}"
  count "${STONKS_FAKE_STATE:?}/$symbol.calls" > /dev/null
  set_name="$(cat "$STONKS_FAKE_STATE/overnight.set" 2>/dev/null)"
  saved_day="$(in_moment "$(tr 'A-Z' 'a-z' <<< "${symbol#%5E}").json")"
  saved_days="$(in_moment "2d/$(tr 'A-Z' 'a-z' <<< "${symbol#%5E}").json")"
  [[ "$url" == *"range=2d&"* && -e "$saved_days" ]] && saved_day=$saved_days
  saved_month="$(in_moment "$(tr 'A-Z' 'a-z' <<< "${symbol#%5E}")-1m.json")"
  saved_quarter="$(in_moment "$(tr 'A-Z' 'a-z' <<< "${symbol#%5E}")-3m.json")"
  if [ -n "$set_name" ] && [ -e "$saved_day" ] && [[ "$url" != *"includeAdjustedClose=true"* ]]; then
    cat "$saved_day"
    exit
  fi
  if [ -n "$set_name" ] && [ -e "$saved_month" ] && [[ "$url" == *"range=1mo&"*"includeAdjustedClose=true"* ]]; then
    count "$STONKS_FAKE_STATE/$symbol.history.calls" > /dev/null
    cat "$saved_month"
    exit
  fi
  if [ -n "$set_name" ] && [ -e "$saved_quarter" ] && [[ "$url" == *"range=3mo&"*"includeAdjustedClose=true"* ]]; then
    count "$STONKS_FAKE_STATE/$symbol.history.calls" > /dev/null
    cat "$saved_quarter"
    exit
  fi
  stamp() { sed "s/\"symbol\":\"[^\"]*\"/\"symbol\":\"$symbol\"/"; }
  # Leaves out a day's buckets from its close on: no trade after it, so the
  # day's move is the one on top. An answer with no prints stays as it is.
  closed() { jq -c '.chart.result[0] |= (if .timestamp then (.meta.currentTradingPeriod.regular.end as $end
    | [.timestamp[] | . < $end] as $keep
    | .timestamp |= map(select(. < $end))
    | .indicators.quote[0] |= map_values(. as $values | [range(0; $keep | length) | select($keep[.]) | $values[.]])) else . end)'; }
  # AAPL's day, up 2.61%, closed with no trade after it; with
  # STONKS_FAKE_STATE/after-hours, its after hours too, its newest price on
  # top.
  answer() { if [ -e "$state/after-hours" ]; then stamp < "$fixtures/aapl.json"; else stamp < "$fixtures/aapl.json" | closed; fi; }
  history() { stamp < "$fixtures/history/aapl-1y.json"; }
  if [[ "$url" == *"includeAdjustedClose=true"* ]]; then
    count "$STONKS_FAKE_STATE/$symbol.history.calls" > /dev/null
    case "$symbol" in
      AAPL|MSFT|TALL*) history ;;
      NEST) cat "$fixtures/history/nest-1mo.json" ;;
      KILN|SPY|%5EGSPC|BTC-USD|SHEL.L|7203.T) cat "$fixtures/history/$(tr 'A-Z.' 'a-z-' <<< "${symbol#%5E}")-1y.json" ;;
      *) exit 22 ;;
    esac
    exit
  fi
  case "$symbol" in
    AAPL|MSFT|NVDA|TALL*) answer ;;
    STRAY) stamp < "$fixtures/nest-2026-09-11-day-prepost.json" ;;
    SHOP.TO) cat "$fixtures/shop-to.json" ;;
    SPY) cat "$fixtures/spy-2026-09-11-day-prepost.json" ;;
    BTC-USD) cat "$fixtures/btc-usd-day.json" ;;
    LONG*) stamp < "$fixtures/moments/listings-2026-10-07-1455/nest.json" ;;
    *) exit 22 ;;
  esac
}

urls=()
format=""
cap=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -w) format=$2; shift 2 ;;
    --max-filesize) cap=$2; shift 2 ;;
    -A|--max-time|--connect-timeout) shift 2 ;;
    http*) urls+=("$1"); shift ;;
    *) shift ;;
  esac
done
# Reject before serving anything, and leave a record finish() cannot mistake
# for a simulated outage. One bun call checks the whole batch, not one per URL.
if ! validated=$(bun "$(dirname "${BASH_SOURCE[0]}")/../../request-url.js" "${urls[@]}"); then
  if [ ! -s "$state/unexpected.requests" ]; then
    printf 'validator failed: %s\n' "${urls[*]}" >> "$state/unexpected.requests"
  fi
  exit 2
fi
mapfile -t urls <<< "$validated"
run=()
for i in "${!urls[@]}"; do
  url=${urls[$i]}
  kind=$(kind_of "$url")
  name=$(name_of "$url" "$kind")
  host=YAHOO
  [[ "$url" == *"robinhood.com"* ]] && host=ROBINHOOD
  [[ "$url" == *"githubusercontent.com"* ]] && host=GITHUB
  run+=("$kind:$name")
  exit_code=0
  retry_after=""
  if [ -e "$state/$host.offline" ]; then
    status=000
    exit_code=7
    body=""
  elif [ -e "$state/$host.refuse" ]; then
    status=429
    body="Too Many Requests"
  else
    # In the background, so a curl stopped mid-answer (search's suspend, a
    # history no longer wanted) stops its answer too, as the real one does.
    out_file="$state/serve.$$.$i"
    serving=""
    trap 'serving=${serving:-${!:-}}; if [ -n "$serving" ]; then kill "$serving" 2> /dev/null; fi; rm -f "$out_file"; exit 143' TERM INT
    serve "$url" > "$out_file" &
    serving=$!
    wait "$serving"
    served=$?
    trap - TERM INT
    body=$(cat "$out_file")
    rm -f "$out_file"
    case $served in
      0) status=200 ;;
      40) status=400 ;;
      43) status=403 ;;
      44) status=404 ;;
      *) status=502 ;;
    esac
    if [ "$cap" -gt 0 ] && [ "${#body}" -gt "$cap" ]; then
      body=${body:0:$cap}
      exit_code=63
    fi
  fi
  echo "$kind $name $status" >> "$state/requests.log"
  printf '%s' "$body"
  out=${format//'%{urlnum}'/$i}
  out=${out//'%{http_code}'/$status}
  out=${out//'%{exitcode}'/$exit_code}
  out=${out//'%header{retry-after}'/$retry_after}
  printf '%b' "$out"
done
echo "${run[*]}" >> "$state/runs.log"
