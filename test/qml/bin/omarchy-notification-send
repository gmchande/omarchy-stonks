#!/usr/bin/env bash
# A stand-in for omarchy-notification-send, first on PATH in the harnesses,
# so no harness shows a notification. Each call is one line of the log,
# every argument followed by a tab, so a harness reads each one whole.
printf '%s\t' "$@" >> "$STONKS_FAKE_STATE/notifications.log"
echo >> "$STONKS_FAKE_STATE/notifications.log"
